# Supabase project (Project Settings > API). Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: comma-separated emails allowed to use the app. Anyone else is signed out.
ALLOWED_EMAILS=

# Google and Outlook sync (server only, never exposed to the browser).
# Service role key: Supabase > Project Settings > API keys > secret key.
SUPABASE_SERVICE_ROLE_KEY=
# Google Cloud console > APIs & Services > Credentials > OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra admin center > App registrations.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
